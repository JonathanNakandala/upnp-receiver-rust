        <!-- Annex B.21 "legacy compatible transforms" - GetAllowedTransforms/
             GetTransforms/SetTransforms/GetAllAvailableTransforms are a set:
             the spec requires implementing all four together if any one is
             implemented. See action.rs's TRANSFORM_DEFS for the actual
             name<->action mapping (one entry per action this renderer
             implements that Annex B.21 names a transform for). -->
        <action>
            <name>GetAllowedTransforms</name>
            <argumentList>
                <argument>
                    <name>InstanceID</name>
                    <direction>in</direction>
                    <relatedStateVariable>A_ARG_TYPE_InstanceID</relatedStateVariable>
                </argument>
                <argument>
                    <name>CurrentAllowedTransformSettings</name>
                    <direction>out</direction>
                    <relatedStateVariable>AllowedTransformSettings</relatedStateVariable>
                </argument>
            </argumentList>
        </action>
        <action>
            <name>GetTransforms</name>
            <argumentList>
                <argument>
                    <name>InstanceID</name>
                    <direction>in</direction>
                    <relatedStateVariable>A_ARG_TYPE_InstanceID</relatedStateVariable>
                </argument>
                <argument>
                    <name>CurrentTransformValues</name>
                    <direction>out</direction>
                    <relatedStateVariable>TransformSettings</relatedStateVariable>
                </argument>
            </argumentList>
        </action>
        <action>
            <name>SetTransforms</name>
            <argumentList>
                <argument>
                    <name>InstanceID</name>
                    <direction>in</direction>
                    <relatedStateVariable>A_ARG_TYPE_InstanceID</relatedStateVariable>
                </argument>
                <argument>
                    <name>DesiredTransformValues</name>
                    <direction>in</direction>
                    <relatedStateVariable>TransformSettings</relatedStateVariable>
                </argument>
            </argumentList>
        </action>
        <!-- Unlike the three actions above, takes no InstanceID - it
             reports this device's whole transform catalog, not anything
             instance-specific (see Table 114 in the spec). -->
        <action>
            <name>GetAllAvailableTransforms</name>
            <argumentList>
                <argument>
                    <name>AllAllowedTransformSettings</name>
                    <direction>out</direction>
                    <relatedStateVariable>AllowedTransformSettings</relatedStateVariable>
                </argument>
            </argumentList>
        </action>
    </actionList>
    <serviceStateTable>
        <!-- Evented as a bundled LastChange NOTIFY (GENA), not individually —
             see the sendEvents="no" on the actual state variables below. -->
        <stateVariable sendEvents="yes">
            <name>LastChange</name>
            <dataType>string</dataType>
        </stateVariable>

        <stateVariable sendEvents="no">
            <name>Volume</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>Mute</name>
            <dataType>boolean</dataType>
        </stateVariable>
        <!-- Plain dB (not centibels), derived from Volume — see
             volume_to_db/db_to_volume in services::rendering_control. -->
        <stateVariable sendEvents="no">
            <name>VolumeDB</name>
            <dataType>i2</dataType>
            <allowedValueRange>
                <minimum>-60</minimum>
                <maximum>0</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>PresetNameList</name>
            <dataType>string</dataType>
        </stateVariable>
        <!-- 0-100, 50 = neutral/no adjustment - see
             services::rendering_control::validate_percent. Vendor-defined
             range per spec; 0-100 chosen for consistency with Volume. -->
        <stateVariable sendEvents="no">
            <name>Brightness</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>Contrast</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <!-- 2-point white balance pair: Output = Gain * Input + BlackLevel
             (see the spec's own xxxVideoGain/xxxVideoBlackLevel relationship
             note). 0-1000, 500 = neutral - wider than Brightness/Contrast's
             0-100 since these are calibration controls where near-black
             precision matters; see gstreamer::video::RenderParams's doc. -->
        <stateVariable sendEvents="no">
            <name>RedVideoGain</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>GreenVideoGain</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>BlueVideoGain</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>RedVideoBlackLevel</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>GreenVideoBlackLevel</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>BlueVideoBlackLevel</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>1000</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <!-- 0-100, 50 = neutral = D65 (6500K), the reference white point of
             every consumer video standard this renderer plays - see
             gstreamer::video::RenderParams::color_temperature's doc. -->
        <stateVariable sendEvents="no">
            <name>ColorTemperature</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <!-- A trapezoidal warp of the displayed video's shape (real
             projector keystone correction), not a color adjustment -
             -50..50, 0 = neutral. See renderer.rs's keystone_scale doc for
             the exact geometry. -->
        <stateVariable sendEvents="no">
            <name>HorizontalKeystone</name>
            <dataType>i2</dataType>
            <allowedValueRange>
                <minimum>-50</minimum>
                <maximum>50</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>VerticalKeystone</name>
            <dataType>i2</dataType>
            <allowedValueRange>
                <minimum>-50</minimum>
                <maximum>50</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <!-- Unsharp masking on luma only - 0-100, 0 = neutral. Unlike every
             other picture control above, neutral sits at this range's own
             minimum, not its midpoint - there's no "soften" concept for
             Sharpness. See shader.wgsl's sharpen_luma doc for the technique. -->
        <stateVariable sendEvents="no">
            <name>Sharpness</name>
            <dataType>ui2</dataType>
            <allowedValueRange>
                <minimum>0</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </allowedValueRange>
        </stateVariable>
        <!-- Physiological loudness compensation (bass/treble boost that
             tapers as volume rises) - a boolean, unlike every other picture/
             audio control above. See gstreamer::audio::apply_loudness's doc
             for the compensation curve and why it has to taper with volume
             rather than being a fixed boost. -->
        <stateVariable sendEvents="no">
            <name>Loudness</name>
            <dataType>boolean</dataType>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>A_ARG_TYPE_PresetName</name>
            <dataType>string</dataType>
            <allowedValueList>
                <allowedValue>FactoryDefaults</allowedValue>
            </allowedValueList>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>A_ARG_TYPE_InstanceID</name>
            <dataType>ui4</dataType>
        </stateVariable>
        <stateVariable sendEvents="no">
            <name>A_ARG_TYPE_Channel</name>
            <dataType>string</dataType>
            <allowedValueList>
                <allowedValue>Master</allowedValue>
            </allowedValueList>
        </stateVariable>
        <!-- CSV of state variable names GetStateVariables should report, or
             "*" for all of them - see action.rs's ALL_STATE_VARIABLE_NAMES
             for the exact set (excludes LastChange/PresetNameList per spec). -->
        <stateVariable sendEvents="no">
            <name>A_ARG_TYPE_StateVariableList</name>
            <dataType>string</dataType>
        </stateVariable>
        <!-- The <stateVariableValuePairs> XML document GetStateVariables
             returns - see action.rs's GetStateVariables handling. -->
        <stateVariable sendEvents="no">
            <name>A_ARG_TYPE_StateVariableValuePairs</name>
            <dataType>string</dataType>
        </stateVariable>
        <!-- The <TransformList> XML document GetAllowedTransforms/
             GetAllAvailableTransforms return - see action.rs's
             allowed_transform_settings_xml. Per spec (5.2.20) this is
             normally also bundled into the LastChange NOTIFY; this renderer
             deliberately doesn't (its value never actually changes at
             runtime, since transform availability here doesn't depend on
             InstanceID or content type), so it stays sendEvents="no" with
             no LastChange entry rather than claim eventing it doesn't do. -->
        <stateVariable sendEvents="no">
            <name>AllowedTransformSettings</name>
            <dataType>string</dataType>
        </stateVariable>
        <!-- The <TransformSettings> XML document GetTransforms returns and
             SetTransforms accepts - see action.rs's
             current_transform_settings_xml/parse_transform_settings. Same
             eventing caveat as AllowedTransformSettings above: per spec
             (5.2.21) this is normally bundled into LastChange too, but
             since it's just a reformatting of state variables already
             evented individually there (Volume, Brightness, ...), this
             renderer doesn't duplicate it into a second XML blob on every
             NOTIFY. -->
        <stateVariable sendEvents="no">
            <name>TransformSettings</name>
            <dataType>string</dataType>
        </stateVariable>
    </serviceStateTable>
</scpd>